{
  "name": "@nexo/crypto-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "MLS, the identity keypair and safety numbers, compiled from crates/crypto to WebAssembly.",
  "main": "pkg/nexo_crypto_wasm.js",

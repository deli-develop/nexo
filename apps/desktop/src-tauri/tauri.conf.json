{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo",
  "version": "0.1.23",
  "identifier": "fit.dice.nexo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexo",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; media-src 'self' data: blob: http://nexo-media.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/deli-develop/nexo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQTI3NUNDM0VEM0E4OTMKUldTVHFOTSt6SFdpVTc4VWljRUpBRjE0c2E3R2ZFQ2NReUdQU2wzWkJ4aC9hWFl2VFdtWDBiYjAK"
    }
  }
}
